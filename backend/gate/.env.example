# Copy to .env (git-ignored) and fill in. Leave DATABASE_URL unset to run with in-memory storage.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/smart_port_management

# Optional tuning of the overbooking layer
GATE_SLOT_CAPACITY=6
GATE_MAX_OVERBOOK=2

# Optional: Component 1 vessel delay feed. GET <url>?vessel=<name>&date=<YYYY-MM-DD> -> {"delay_hours": <number>}
# Leave unset to use the labelled simulated vessel schedule.
# VESSEL_API_URL=http://localhost:9000/vessel-delay
